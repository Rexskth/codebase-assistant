# Environment variables for AI Engineering Assistant

# OpenRouter API Key (required for the AI agent)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Model to use (defaults to openai/gpt-5.5)
MODEL_NAME=openai/gpt-5.5

# MCP Server Configuration (optional, defaults provided)
# MCP_HOST=localhost
# MCP_PORT=8000

# Project Path (optional, defaults to current directory)
# PROJECT_PATH=/path/to/your/project